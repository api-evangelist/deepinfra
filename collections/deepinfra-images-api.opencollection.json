{
  "opencollection": "1.0.0",
  "info": {
    "name": "DeepInfra Inference Audio Images API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate images from a prompt",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.deepinfra.com/v1/openai/images/generations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate images from a prompt"
        }
      ]
    }
  ],
  "bundled": true
}